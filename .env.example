VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# The live domain, named in the Privacy Policy and Terms pages.
# Also used as the base for WhatsApp button links in scripts/test-templates.mjs.
VITE_SITE_URL=

# Set to 1 on a demo build to let ?sections=header:centered,... preview other section
# versions (dev always allows it). Leave empty on the live store. See docs/template/SECTIONS.md.
VITE_SECTION_PREVIEW=

FIREBASE_ADMIN_SDK_BASE64=replace-with-base64-service-account-json
ADMIN_NOTIFICATION_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# WhatsApp Business Account ID (Meta API Setup page). Needed to create, list and delete templates from the admin.
WHATSAPP_WABA_ID=
# Optional: the Meta App ID (App settings -> Basic). Only needed if creating a picture template says it cannot find the app ID.
# WHATSAPP_APP_ID=replace-with-your-meta-app-id
# Meta app secret (App settings -> Basic). The webhook rejects unsigned payloads without it.
WHATSAPP_APP_SECRET=
# Any random string; enter the same value as the Verify token in Meta -> WhatsApp -> Configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_login
# Every template in the code is sent as "en" (English), so create templates as English, not English (US).
WHATSAPP_OTP_LANG=en
# Gemini API key(s). You can list MULTIPLE keys separated by commas to multiply
# the free-tier daily quota (free quota is per Google project, so use keys from
# different projects/accounts). The server rotates across them and also falls
# back across models on a 429. Optional: GEMINI_MODELS to override the model chain.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite,gemini-2.0-flash-lite

VITE_METERED_TURN_API_URL=
VITE_METERED_TURN_API_KEY=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Razorpay — server-side (NEVER expose the secret to the frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay — public key id, safe to ship to the browser (used by checkout.js)
VITE_RAZORPAY_KEY_ID=
# Image storage provider: "r2" (default, uploads via /api/media) or "cloudinary"
# (temporary: the browser uploads straight to Cloudinary with an unsigned preset,
# and the storefront reads products from Firestore instead of the R2 catalog snapshot).
VITE_MEDIA_PROVIDER=r2
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Cloudflare R2 media storage — server-side only (NEVER prefix with VITE_)
# Create keys: Cloudflare dashboard -> R2 -> Manage API Tokens -> Account API token (Object Read & Write)
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=replace-with-bucket-name
# Public read URL of the bucket, no trailing slash (r2.dev URL, or custom domain for production)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Day of the month your Cloudflare billing period starts (1-28)
R2_BILLING_CYCLE_DAY=1
# Optional but recommended: Cloudflare API token with "Account Analytics: Read"
# AND "Cache Purge" (for the zone) — both can live on the same token.
# Without Analytics:Read, image views (Class B) can't be measured (usage is estimated).
# Without Cache Purge, a deleted photo can keep serving from Cloudflare's cache for
# up to a year even though it's gone from R2.
CLOUDFLARE_ANALYTICS_TOKEN=
# The zone ID for the domain R2_PUBLIC_URL uses (Cloudflare dashboard -> your domain
# -> Overview -> "Zone ID" in the right sidebar). Needed for Cache Purge above.
CLOUDFLARE_ZONE_ID=
