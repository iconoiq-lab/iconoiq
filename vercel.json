{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/create-order.ts": {
      "maxDuration": 20
    },
    "api/verify-payment.ts": {
      "maxDuration": 20
    },
    "api/notify-order.ts": {
      "maxDuration": 20
    },
    "api/broadcast.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/catalog/products.json",
      "destination": "/api/media?catalog=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/media?sitemap=1"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/media?llms=1"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|vkShare).*"
        }
      ],
      "destination": "/api/media?og=product&id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
